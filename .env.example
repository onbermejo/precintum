# Clave privada del Evidence Agent (formato nsec, NIP-19). Genera una con: pnpm precintum keygen
# NUNCA la subas al repo. En producción vendrá de un gestor de secretos.
PRECINTUM_NSEC=
# Clave pública del agente (npub). Solo la necesita un proceso de solo lectura (`serve`) en una
# máquina que no debe tener el nsec. Si están las dos, tienen que corresponderse.
PRECINTUM_NPUB=
# Clave RAÍZ del operador (npub): la que firma el directorio de claves (kind 37676). Si está, la
# búsqueda de borrados NIP-09 vigila también los kind 5 de la raíz y los que apuntan al directorio.
PRECINTUM_ROOT_NPUB=

# Relays de testigos, separados por comas (wss://...). Revise su disponibilidad y la diversidad
# de operadores e implementaciones antes del despliegue.
PRECINTUM_RELAYS=wss://nos.lol,wss://relay.primal.net,wss://relay.damus.io,wss://nostr-pub.wellorder.net

# Nivel de log: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Base de datos de evidencia.
#   pglite:./data/precintum                          PGlite en disco, cero configuración (por defecto).
#                                               UN SOLO PROCESO A LA VEZ: `serve` y los demás comandos
#                                               no pueden correr juntos sobre PGlite (se corrompería en
#                                               silencio); el segundo proceso falla con un aviso.
#                                               Para operar en continuo usa PostgreSQL.
#   pglite:memory                               PGlite en memoria (se pierde al salir)
#   postgres://postgres:CLAVE@localhost:5432/precintum   PostgreSQL nativo (crea antes la BD: createdb precintum)
PRECINTUM_DATABASE_URL=pglite:./data/precintum

# Clave HMAC de deduplicación (32 bytes hex). `pnpm precintum keygen` sugiere una.
# Sin ella, cada ejecución usa una efímera y los reintentos entre ejecuciones no se deduplican.
PRECINTUM_DEDUP_KEY=

# Vida de la correlación transacción↔recibo, en segundos (24 h por defecto).
PRECINTUM_DEDUP_TTL_SECONDS=86400

# Capa de testigos: cuántos relays deben aceptar un evento (N de M), y el archivo
# append-only local.
# Se cuentan direcciones únicas de esta lista: mayúsculas del host, puerto por defecto y barra
# raíz no añaden testigos. El quórum no puede superar esas direcciones únicas.
PRECINTUM_WITNESS_QUORUM=2
PRECINTUM_ARCHIVE_PATH=./data/witness/archive.jsonl

# Lotes y anclaje. Ventana fija en segundos (una raíz por ventana, también vacía),
# política vigente (etiqueta que se hashea, o hash hex), TSA RFC 3161, calendarios OpenTimestamps
# y gap máximo admisible entre el fin de la ventana y su prueba de tiempo.
PRECINTUM_BATCH_WINDOW_SECONDS=3600
# Margen tras el fin de una ventana antes de cerrarla (segundos): da tiempo a los recibos que llegan
# con latencia del verifier. Tolerancia del instante declarado hacia el futuro (segundos).
PRECINTUM_BATCH_GRACE_SECONDS=120
PRECINTUM_MAX_FUTURE_SKEW_SECONDS=300
PRECINTUM_POLICY=age_over_18/v1
# PRECINTUM_TSA_URL: autoridad de sellado de tiempo RFC 3161. freetsa.org es gratuita y de DESARROLLO:
# NO es un prestador cualificado y no da la presunción legal de eIDAS. En producción, apunta a la
# TSA que tengas contratada o a la de un QTSP si quieres esa presunción. El anclaje en Bitcoin
# (PRECINTUM_OTS_CALENDARS) es independiente y no sustituye a la TSA.
PRECINTUM_TSA_URL=https://freetsa.org/tsr
# Credenciales de la TSA si el prestador las exige (autenticación HTTP básica). Ambas o ninguna.
# Con un lote por hora, un cliente consume unos 8.760 sellos al año.
PRECINTUM_TSA_USER=
PRECINTUM_TSA_PASSWORD=
# Las direcciones de calendario forman parte de las pruebas OTS que se pueden compartir.
# Solo HTTP(S), sin usuario/contraseña, parámetros de consulta ni fragmentos.
# El lector pending admite URI ASCII; no admite literales IPv6 ni escapes con %.
PRECINTUM_OTS_CALENDARS=https://a.pool.opentimestamps.org,https://b.pool.opentimestamps.org
PRECINTUM_ANCHOR_MAX_GAP_SECONDS=86400

# Proceso `precintum run` (ADR-0002) e ingesta (ADR-0003). El token lo comparte el adaptador del
# verifier o del vendor para llamar a POST /receipts; `pnpm precintum keygen` sugiere uno.
PRECINTUM_INGEST_TOKEN=
PRECINTUM_INGEST_HOST=127.0.0.1
PRECINTUM_INGEST_PORT=8788
# Cadencias del planificador, en segundos: cierre de ventanas y outbox, anclajes, presencia en los
# testigos y busqueda de borrados NIP-09.
PRECINTUM_RUN_TICK_SECONDS=30
PRECINTUM_RUN_ANCHOR_SECONDS=600
PRECINTUM_RUN_PRESENCE_SECONDS=21600
PRECINTUM_RUN_DELETIONS_SECONDS=3600
