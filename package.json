{
  "name": "precintum",
  "version": "0.1.0",
  "description": "Precintum — capa de evidencia sin PII para verificaciones EUDI, con testigos en relays Nostr y anclaje OpenTimestamps",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "precintum": "node --env-file-if-exists=.env src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:it": "PRECINTUM_IT=1 vitest run .it.test",
    "vectors": "node scripts/format-vectors.ts",
    "example:web": "node scripts/make-web-example.ts",
    "example:panel": "node scripts/make-panel-demo.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/infra/http/panel.html','dist/infra/http/panel.html')\"",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "demo": "node scripts/demo.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@peculiar/asn1-cms": "2.9.4",
    "@peculiar/asn1-schema": "2.9.4",
    "@peculiar/asn1-tsp": "2.9.4",
    "@peculiar/asn1-x509": "2.9.4",
    "@scure/base": "2.4.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "nostr-tools": "2.25.1",
    "pino-pretty": "13.1.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "ws": "8.21.3"
  }
}
